<section class="container mx-auto py-20 px-6">
  <div class="flex items-center justify-between mb-10">
    <h2 class="font-display text-3xl font-bold">
      {%- if request.locale.iso_code == 'ar' -%}
        {{ section.settings.title_ar }}
      {%- else -%}
        {{ section.settings.title_en }}
      {%- endif -%}
    </h2>
    {%- if section.settings.collection != blank -%}
      <a href="{{ collections[section.settings.collection].url }}" class="text-sm text-primary hover:underline underline-offset-4 tracking-wide">
        {%- if request.locale.iso_code == 'ar' -%}
          عرض الكل
        {%- else -%}
          View All
        {%- endif -%}
      </a>
    {%- endif -%}
  </div>

  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
    {%- assign featured_collection = collections[section.settings.collection] -%}
    {%- if featured_collection != blank and featured_collection.products_count > 0 -%}
      {%- for product in featured_collection.products limit: section.settings.limit -%}
        {% render 'product-card', product: product, index: forloop.index0 %}
      {%- endfor -%}
    {%- else -%}
      <!-- Fallback empty/onboarding state -->
      {%- for i in (1..section.settings.limit) -%}
        <div class="group flex flex-col bg-card rounded overflow-hidden p-4 border border-border animate-pulse">
          <div class="aspect-square bg-muted rounded mb-4"></div>
          <div class="h-4 bg-muted rounded w-3/4 mb-2"></div>
          <div class="h-4 bg-muted rounded w-1/4"></div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    {
      "type": "text",
      "id": "title_ar",
      "label": "Heading (Arabic)",
      "default": "مميّز"
    },
    {
      "type": "text",
      "id": "title_en",
      "label": "Heading (English)",
      "default": "Featured"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 4,
      "max": 12,
      "step": 4,
      "default": 4,
      "label": "Product Limit"
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}
