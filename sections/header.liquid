<nav class="fixed top-0 left-0 right-0 z-50 border-b border-border bg-background/80 backdrop-blur-xl">
  <div class="container mx-auto flex items-center justify-between h-16 px-6">
    <a href="{{ routes.root_url }}" class="font-display text-3xl font-bold text-gradient-gold tracking-tight">
      {{ section.settings.logo_text | default: shop.name }}
    </a>

    <!-- Desktop Navigation Menu -->
    <div class="hidden md:flex items-center gap-8 text-sm font-medium tracking-wide">
      {%- for link in linklists[section.settings.menu].links -%}
        <a href="{{ link.url }}" class="text-muted-foreground hover:text-foreground transition-colors {% if link.active %}text-primary{% endif %}">
          {{ link.title }}
        </a>
      {%- endfor -%}
    </div>

    <div class="flex items-center gap-3">
      <!-- Theme Switcher (Dark/Light) -->
      <button id="ThemeToggle" class="text-muted-foreground hover:text-foreground transition-colors p-1.5" aria-label="Toggle theme">
        <!-- Sun icon (shown in dark mode) -->
        <svg class="w-4 h-4 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m0-12.728l.707.707m12.728 12.728l.707-.707M12 8a4 4 0 100 8 4 4 0 000-8z"></path>
        </svg>
        <!-- Moon icon (shown in light mode) -->
        <svg class="w-4 h-4 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
        </svg>
      </button>

      <!-- Language Toggle Form -->
      {%- form 'localization', id: 'LanguageForm', class: 'm-0 p-0 flex items-center' -%}
        <input type="hidden" name="locale_code" id="LocaleCode" value="{{ request.locale.iso_code }}">
        <button type="button" id="LangToggleBtn" class="flex items-center gap-1 text-xs font-medium text-muted-foreground hover:text-foreground transition-colors uppercase tracking-wider p-1.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path>
          </svg>
          <span>{%- if request.locale.iso_code == 'ar' -%}EN{%- else -%}ع{%- endif -%}</span>
        </button>
      {%- endform -%}

      <!-- Cart Icon Link -->
      <a href="{{ routes.cart_url }}" class="relative text-foreground hover:text-primary transition-colors p-1.5">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
        </svg>
        <span id="CartBubble" class="absolute -top-1 -right-1 w-4 h-4 rounded-full bg-primary text-primary-foreground text-[10px] flex items-center justify-center font-bold {% if cart.item_count == 0 %}hidden{% endif %}">
          {{ cart.item_count }}
        </span>
      </a>

      <!-- Mobile Menu Toggle -->
      <button id="MobileMenuToggle" class="md:hidden text-foreground p-1.5" aria-label="Toggle mobile menu">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Navigation Menu -->
  <div id="MobileMenu" class="hidden md:hidden border-t border-border bg-background/95 backdrop-blur-xl overflow-hidden transition-all duration-300 max-h-0">
    <div class="container mx-auto py-4 px-6 flex flex-col gap-4">
      {%- for link in linklists[section.settings.menu].links -%}
        <a href="{{ link.url }}" class="text-sm tracking-wide text-muted-foreground hover:text-foreground {% if link.active %}text-primary{% endif %}">
          {{ link.title }}
        </a>
      {%- endfor -%}
    </div>
  </div>
</nav>

<!-- Nav Spacer to prevent contents from going under navbar -->
<div class="h-16"></div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Theme toggle logic
    const themeToggleBtn = document.getElementById('ThemeToggle');
    if (themeToggleBtn) {
      themeToggleBtn.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      });
    }

    // Language toggle logic
    const langToggleBtn = document.getElementById('LangToggleBtn');
    const languageForm = document.getElementById('LanguageForm');
    const localeInput = document.getElementById('LocaleCode');
    if (langToggleBtn && languageForm && localeInput) {
      langToggleBtn.addEventListener('click', () => {
        const currentLocale = localeInput.value;
        localeInput.value = currentLocale === 'ar' ? 'en' : 'ar';
        languageForm.submit();
      });
    }

    // Mobile menu toggle
    const mobileMenuToggle = document.getElementById('MobileMenuToggle');
    const mobileMenu = document.getElementById('MobileMenu');
    if (mobileMenuToggle && mobileMenu) {
      mobileMenuToggle.addEventListener('click', () => {
        if (mobileMenu.classList.contains('hidden')) {
          mobileMenu.classList.remove('hidden');
          setTimeout(() => {
            mobileMenu.style.maxHeight = '300px';
          }, 10);
        } else {
          mobileMenu.style.maxHeight = '0';
          setTimeout(() => {
            mobileMenu.classList.add('hidden');
          }, 300);
        }
      });
    }
  });
</script>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text",
      "default": "أصل"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
