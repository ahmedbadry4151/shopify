<div class="container mx-auto pt-28 pb-20 text-center px-6 animate-fade-up">
  <h1 class="font-display text-7xl font-bold text-gradient-gold mb-4">404</h1>
  <p class="text-muted-foreground mb-8 text-lg">
    {%- if request.locale.iso_code == 'ar' -%}
      عذرًا، الصفحة التي تبحث عنها غير موجودة.
    {%- else -%}
      Oops! The page you are looking for does not exist.
    {%- endif -%}
  </p>
  <a href="{{ routes.root_url }}">
    <button class="magnetic-btn bg-primary text-primary-foreground px-8 py-3.5 font-semibold text-sm uppercase tracking-wider hover:opacity-90 transition-opacity rounded">
      {%- if request.locale.iso_code == 'ar' -%}
        العودة للرئيسية
      {%- else -%}
        Back to Home
      {%- endif -%}
    </button>
  </a>
</div>

{% schema %}
{
  "name": "Main 404",
  "settings": []
}
{% endschema %}
