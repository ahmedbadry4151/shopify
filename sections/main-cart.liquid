<div class="container mx-auto pt-12 pb-20 max-w-3xl px-6" id="CartSectionContainer">
  <!-- Continue Shopping link -->
  <div class="mb-8 {% if request.locale.iso_code == 'ar' %}text-right{% else %}text-left{% endif %}">
    <a href="/collections/all" class="inline-flex items-center gap-1 text-sm text-muted-foreground hover:text-foreground">
      <svg class="w-4 h-4 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
      <span>{%- if request.locale.iso_code == 'ar' -%}تابع التسوق{%- else -%}Continue Shopping{%- endif -%}</span>
    </a>
  </div>

  <h1 class="font-display text-3xl font-bold mb-8 {% if request.locale.iso_code == 'ar' %}text-right{% else %}text-left{% endif %}">
    {%- if request.locale.iso_code == 'ar' -%}سلة التسوق{%- else -%}Cart{%- endif -%}
  </h1>

  {%- if cart.item_count == 0 -%}
    <!-- Empty State -->
    <div class="text-center py-20 animate-fade-up">
      <h2 class="font-display text-2xl font-semibold mb-4">
        {%- if request.locale.iso_code == 'ar' -%}سلة التسوق فارغة{%- else -%}Your Cart is Empty{%- endif -%}
      </h2>
      <a href="/collections" class="text-primary hover:underline uppercase text-sm tracking-wide">
        {%- if request.locale.iso_code == 'ar' -%}تابع التسوق{%- else -%}Continue Shopping{%- endif -%}
      </a>
    </div>
  {%- else -%}
    <!-- Cart Items Form -->
    <form action="{{ routes.cart_url }}" method="post" id="CartForm" class="space-y-6 animate-fade-up">
      <div class="space-y-6">
        {%- for item in cart.items -%}
          <div class="flex gap-4 border-b border-border pb-6 {% if request.locale.iso_code == 'ar' %}flex-row-reverse text-right{% endif %}" data-line-item-key="{{ item.key }}">
            <!-- Item Image -->
            <div class="w-24 h-24 shrink-0 rounded overflow-hidden bg-muted">
              {%- if item.image != blank -%}
                <img src="{{ item.image | image_url: width: 240 }}" alt="{{ item.title | escape }}" class="w-full h-full object-cover">
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'w-full h-full object-cover' }}
              {%- endif -%}
            </div>

            <!-- Item Details -->
            <div class="flex-grow min-w-0">
              <h3 class="font-display font-semibold truncate text-foreground">{{ item.product.title }}</h3>
              
              <!-- Variant options -->
              {%- unless item.product.has_only_default_variant -%}
                <p class="text-xs text-muted-foreground mt-0.5">
                  {%- for option in item.options_with_values -%}
                    {{ option.name }}: {{ option.value }}{% unless forloop.last %} | {% endunless %}
                  {%- endfor -%}
                </p>
              {%- endunless -%}

              <p class="text-sm text-primary font-semibold mt-1">{{ item.final_line_price | money }}</p>

              <!-- Quantity selector and Remove -->
              <div class="flex items-center gap-3 mt-3 {% if request.locale.iso_code == 'ar' %}flex-row-reverse{% endif %}">
                <!-- Minus -->
                <button
                  type="button"
                  class="qty-btn text-muted-foreground hover:text-foreground p-1"
                  data-action="minus"
                  data-current-qty="{{ item.quantity }}"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"></path>
                  </svg>
                </button>
                
                <!-- Display -->
                <span class="text-sm font-medium w-6 text-center select-none">{{ item.quantity }}</span>
                
                <!-- Plus -->
                <button
                  type="button"
                  class="qty-btn text-muted-foreground hover:text-foreground p-1"
                  data-action="plus"
                  data-current-qty="{{ item.quantity }}"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                  </svg>
                </button>

                <!-- Trash -->
                <button
                  type="button"
                  class="remove-btn {% if request.locale.iso_code == 'ar' %}mr-auto{% else %}ml-auto{% endif %} text-muted-foreground hover:text-destructive p-1"
                  aria-label="Remove item"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                  </svg>
                </button>
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>

      <!-- Subtotal and checkout -->
      <div class="mt-8 border-t border-border pt-6 flex items-center justify-between {% if request.locale.iso_code == 'ar' %}flex-row-reverse{% endif %}">
        <p class="font-display text-xl font-bold">
          {%- if request.locale.iso_code == 'ar' -%}المجموع{%- else -%}Total{%- endif -%}
        </p>
        <p class="font-display text-2xl font-bold text-primary">
          {{ cart.total_price | money }}
        </p>
      </div>

      <button
        type="submit"
        name="checkout"
        class="w-full bg-primary text-primary-foreground py-3.5 font-semibold text-sm uppercase tracking-wider hover:opacity-90 transition-opacity rounded hover:shadow-[0_0_20px_hsl(var(--primary)/0.4)]"
      >
        {%- if request.locale.iso_code == 'ar' -%}إتمام الشراء{%- else -%}Checkout{%- endif -%}
      </button>
    </form>
  {%- endif -%}
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    initCartActions();

    function initCartActions() {
      // Line item updates via Shopify Ajax API
      const qtyButtons = document.querySelectorAll('#CartForm .qty-btn');
      const removeButtons = document.querySelectorAll('#CartForm .remove-btn');

      qtyButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          const action = btn.getAttribute('data-action');
          const currentQty = parseInt(btn.getAttribute('data-current-qty'));
          const itemElement = btn.closest('[data-line-item-key]');
          const key = itemElement.getAttribute('data-line-item-key');
          
          let newQty = currentQty;
          if (action === 'plus') {
            newQty = currentQty + 1;
          } else if (action === 'minus' && currentQty > 1) {
            newQty = currentQty - 1;
          }

          if (newQty !== currentQty) {
            updateCartQuantity(key, newQty);
          }
        });
      });

      removeButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          const itemElement = btn.closest('[data-line-item-key]');
          const key = itemElement.getAttribute('data-line-item-key');
          updateCartQuantity(key, 0);
        });
      });
    }

    function updateCartQuantity(key, quantity) {
      const container = document.getElementById('CartSectionContainer');
      if (container) {
        container.style.opacity = '0.5';
      }

      fetch('/cart/change.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          id: key,
          quantity: quantity
        })
      })
      .then(res => res.json())
      .then(cartData => {
        // Fetch new HTML for this section using the Section Rendering API
        fetch('/cart?sections=main-cart')
        .then(res => res.json())
        .then(sectionHtml => {
          const parser = new DOMParser();
          const doc = parser.parseFromString(sectionHtml['main-cart'], 'text/html');
          const newContent = doc.getElementById('CartSectionContainer').innerHTML;
          
          const mainContainer = document.getElementById('CartSectionContainer');
          if (mainContainer) {
            mainContainer.innerHTML = newContent;
            mainContainer.style.opacity = '1';
            
            // Re-initialize event listeners on the newly added HTML!
            initCartActions();
          }

          // Update header cart bubble
          const bubble = document.getElementById('CartBubble');
          if (bubble) {
            bubble.textContent = cartData.item_count;
            if (cartData.item_count > 0) {
              bubble.classList.remove('hidden');
            } else {
              bubble.classList.add('hidden');
            }
          }
        });
      })
      .catch(err => {
        console.error(err);
        if (container) container.style.opacity = '1';
      });
    }
  });
</script>

{% schema %}
{
  "name": "Main Cart",
  "settings": []
}
{% endschema %}
