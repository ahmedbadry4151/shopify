<section class="container mx-auto pb-20 px-6">
  <div class="relative rounded overflow-hidden bg-muted aspect-[21/9] flex items-center justify-center group animate-fade-up">
    {%- if section.settings.image != blank -%}
      <img
        src="{{ section.settings.image | image_url: width: 1600 }}"
        alt="{{ section.settings.image.alt | escape }}"
        loading="lazy"
        class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
        style="opacity: {{ section.settings.opacity | divided_by: 100.0 }};"
        width="1600"
        height="685"
      >
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'absolute inset-0 w-full h-full object-cover opacity-20 transition-transform duration-700 group-hover:scale-105' }}
    {%- endif -%}
    <div class="relative text-center px-6 z-10">
      <p class="text-primary uppercase tracking-[0.3em] text-xs mb-3">
        {%- if request.locale.iso_code == 'ar' -%}
          {{ section.settings.subheading_ar }}
        {%- else -%}
          {{ section.settings.subheading_en }}
        {%- endif -%}
      </p>
      <h2 class="font-display text-3xl md:text-5xl font-bold mb-4 text-foreground">
        {%- if request.locale.iso_code == 'ar' -%}
          {{ section.settings.heading_ar }}
        {%- else -%}
          {{ section.settings.heading_en }}
        {%- endif -%}
      </h2>
      <a href="{{ section.settings.button_link | default: '/collections/all' }}">
        <button class="magnetic-btn inline-flex items-center gap-2 border border-primary text-primary px-6 py-2.5 text-sm tracking-wider hover:bg-primary hover:text-primary-foreground transition-colors rounded">
          {%- if request.locale.iso_code == 'ar' -%}
            {{ section.settings.button_ar }}
          {%- else -%}
            {{ section.settings.button_en }}
          {%- endif -%}
        </button>
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Promotional Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner Image"
    },
    {
      "type": "range",
      "id": "opacity",
      "min": 10,
      "max": 100,
      "step": 10,
      "default": 20,
      "label": "Image Opacity (%)"
    },
    {
      "type": "text",
      "id": "subheading_ar",
      "label": "Subheading (Arabic)",
      "default": "مجموعة جديدة"
    },
    {
      "type": "text",
      "id": "subheading_en",
      "label": "Subheading (English)",
      "default": "New Collection"
    },
    {
      "type": "text",
      "id": "heading_ar",
      "label": "Heading (Arabic)",
      "default": "قصك في حاجة؟"
    },
    {
      "type": "text",
      "id": "heading_en",
      "label": "Heading (English)",
      "default": "Got Something?"
    },
    {
      "type": "text",
      "id": "button_ar",
      "label": "Button Label (Arabic)",
      "default": "اكتشف"
    },
    {
      "type": "text",
      "id": "button_en",
      "label": "Button Label (English)",
      "default": "Discover"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Promotional Banner"
    }
  ]
}
{% endschema %}
