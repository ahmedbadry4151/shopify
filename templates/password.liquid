{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="dark">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }} — Password Protected</title>
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    <style>
      body {
        background-color: hsl(0 0% 4%);
        color: hsl(40 20% 92%);
        font-family: 'Outfit', sans-serif;
      }
    </style>
  </head>
  <body class="min-h-screen flex flex-col items-center justify-center p-6 text-center">
    <div class="max-w-md w-full bg-card border border-border rounded p-8 shadow-2xl">
      <h1 class="font-display text-4xl font-bold text-gradient-gold mb-2">أصل</h1>
      <p class="text-muted-foreground text-sm mb-6">Our store is opening soon!</p>

      {%- form 'storefront_password' -%}
        {%- if form.errors -%}
          <div class="bg-destructive/20 border border-destructive text-destructive p-3 rounded text-sm mb-4">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="space-y-4">
          <input
            type="password"
            name="password"
            id="password"
            placeholder="Enter password"
            class="w-full bg-muted border border-border rounded px-4 py-2.5 text-sm text-foreground focus:outline-none focus:ring-1 focus:ring-primary text-center"
            required
          >
          <button
            type="submit"
            class="w-full bg-primary text-primary-foreground py-2.5 font-semibold text-sm uppercase tracking-wider hover:opacity-90 transition-opacity rounded"
          >
            Enter Store
          </button>
        </div>
      {%- endform -%}
    </div>
  </body>
</html>
